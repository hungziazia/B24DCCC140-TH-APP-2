<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/FirstFragment">

    <!-- Màn hình 1: Đăng nhập -->
    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.example.app2.FirstFragment"
        android:label="Đăng nhập"
        tools:layout="@layout/fragment_first">
        <action
            android:id="@+id/action_FirstFragment_to_SecondFragment"
            app:destination="@id/SecondFragment" />
    </fragment>

    <!-- Màn hình 2: Trang chủ -->
    <fragment
        android:id="@+id/SecondFragment"
        android:name="com.example.app2.SecondFragment"
        android:label="Trang chủ"
        tools:layout="@layout/fragment_second">
        <action
            android:id="@+id/action_SecondFragment_to_AddTaskFragment"
            app:destination="@id/AddTaskFragment" />
    </fragment>

    <!-- Màn hình 3: Thêm mới -->
    <fragment
        android:id="@+id/AddTaskFragment"
        android:name="com.example.app2.AddTaskFragment"
        android:label="Thêm mới"
        tools:layout="@layout/fragment_add_task" />
</navigation>